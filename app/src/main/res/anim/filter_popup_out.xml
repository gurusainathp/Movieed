<?xml version="1.0" encoding="utf-8"?><!-- Dropdown closes: quickly fades while shrinking back toward its top-left corner and lifting slightly.
     Exits use an accelerating curve, so it leaves briskly instead of lingering. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_linear_in"
    android:shareInterpolator="true">
    <alpha
        android:duration="120"
        android:fromAlpha="1.0"
        android:toAlpha="0.0" />
    <scale
        android:duration="140"
        android:fromXScale="1.0"
        android:fromYScale="1.0"
        android:pivotX="20%"
        android:pivotY="0%"
        android:toXScale="0.96"
        android:toYScale="0.90" />
    <translate
        android:duration="140"
        android:fromYDelta="0%"
        android:toYDelta="-3%" />
</set>