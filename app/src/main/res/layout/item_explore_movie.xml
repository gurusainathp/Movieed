<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/movieed_background">

    <ImageView
        android:id="@+id/iv_explore_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:background="@color/movieed_surface_elevated"
        tools:src="@tools:sample/backgrounds/scenic" />

    <!-- Gradient overlay for readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B30F1015" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="50dp">

            <!-- Movie Info Header + Reason Poster Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="top">

                <!-- Left Details (Clickable to open details) -->
                <LinearLayout
                    android:id="@+id/layout_explore_header_details"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:id="@+id/tv_explore_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/movieed_text_primary"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        tools:text="Oppenheimer" />

                    <TextView
                        android:id="@+id/tv_explore_year"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/movieed_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="2023" />

                    <TextView
                        android:id="@+id/tv_explore_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/movieed_accent"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="★ 8.9" />

                </LinearLayout>

                <!-- Right Reason Badge Card with Poster (Clickable to jump to context) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_explore_reason"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/movieed_surface"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:strokeColor="@color/movieed_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_explore_reason_poster"
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop"
                            android:background="@color/movieed_surface_elevated"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"
                            tools:src="@tools:sample/backgrounds/scenic" />

                        <TextView
                            android:id="@+id/tv_explore_reason_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:gravity="center"
                            android:maxLines="3"
                            android:ellipsize="end"
                            android:textColor="@color/movieed_primary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            tools:text="Because you loved Inception" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Synopsis Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="SYNOPSIS"
                android:textColor="@color/movieed_primary"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_explore_overview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/movieed_text_primary"
                android:textSize="14sp"
                tools:text="The story of American scientist J. Robert Oppenheimer and his role in the development of the atomic bomb." />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Floating Action Bar for Watchlist & Reaction -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_floating_action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="@color/movieed_surface"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/movieed_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_action_watchlist"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="+ Watchlist"
                android:textColor="@color/movieed_text_primary"
                app:strokeColor="@color/movieed_border" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_action_rate"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/movieed_primary"
                android:text="Rate"
                android:textColor="@color/movieed_background" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
