<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/movieed_background">

    <!-- Full-bleed movie backdrop background -->
    <ImageView
        android:id="@+id/iv_person_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:background="@color/movieed_surface_elevated"
        tools:src="@tools:sample/backgrounds/scenic" />

    <!-- Dark gradient overlay for readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B30F1015" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="70dp">

            <!-- Person Info Header with Profile Photo on the Right -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal">

                <!-- Left Details -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_person_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/movieed_text_primary"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        tools:text="Christian Bale" />

                    <TextView
                        android:id="@+id/tv_person_department"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/movieed_accent"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="Acting" />

                    <TextView
                        android:id="@+id/tv_person_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/movieed_text_secondary"
                        android:textSize="12sp"
                        tools:text="Born: Jan 30, 1974\nHaverfordwest, Wales" />

                </LinearLayout>

                <!-- Right Profile Photo Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_person_profile"
                    android:layout_width="120dp"
                    android:layout_height="170dp"
                    android:layout_marginStart="16dp"
                    app:cardBackgroundColor="@color/movieed_surface"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="6dp"
                    app:strokeColor="@color/movieed_border"
                    app:strokeWidth="1dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/iv_person_profile"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="@color/movieed_surface_elevated"
                        tools:src="@tools:sample/backgrounds/scenic" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- BIOGRAPHY -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:letterSpacing="0.12"
                android:text="BIOGRAPHY"
                android:textColor="@color/movieed_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_person_biography"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:lineSpacingExtra="4dp"
                android:maxLines="4"
                android:textColor="@color/movieed_text_primary"
                android:textSize="14sp"
                tools:text="Christian Charles Philip Bale is an English actor..." />

            <TextView
                android:id="@+id/tv_read_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Read More"
                android:textColor="@color/movieed_accent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- KNOWN FOR -->
            <TextView
                android:id="@+id/tv_known_for_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:letterSpacing="0.12"
                android:text="KNOWN FOR"
                android:textColor="@color/movieed_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_person_known_for"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_home_movie_card" />

            <!-- FILMOGRAPHY -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:letterSpacing="0.12"
                android:text="FILMOGRAPHY"
                android:textColor="@color/movieed_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_person_filmography"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_person_credit" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_show_all_filmography"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Show All Filmography"
                android:textColor="@color/movieed_accent"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
