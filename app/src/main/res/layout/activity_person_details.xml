<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/movieed_background">

    <!-- Static full-screen backdrop (does not scroll) -->
    <ImageView
        android:id="@+id/iv_person_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/movieed_surface_elevated"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        tools:src="@tools:sample/backgrounds/scenic" />

    <!-- Flat dim in the page colour: just lowers the backdrop's visibility, no gradient.
         Raise/lower android:alpha to taste (0.0 = fully visible, 1.0 = hidden). -->
    <View
        android:id="@+id/view_backdrop_dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.75"
        android:background="@color/movieed_background" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_person"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="48dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ============ HEADER ============ -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="28dp"
                    android:paddingBottom="20dp">

                    <!-- Left: role pill, name, facts -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_person_department"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_unselected_filter"
                            android:letterSpacing="0.1"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:textAllCaps="true"
                            android:textColor="@color/movieed_primary"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            tools:text="Actor" />

                        <TextView
                            android:id="@+id/tv_person_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:ellipsize="end"
                            android:maxLines="3"
                            android:textColor="@color/movieed_text_primary"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            tools:text="Christian Bale" />

                        <TextView
                            android:id="@+id/tv_person_info"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:lineSpacingExtra="3dp"
                            android:textColor="@color/movieed_text_secondary"
                            android:textSize="13sp"
                            tools:text="Born: Jan 30, 1974\nHaverfordwest, Wales" />

                    </LinearLayout>

                    <!-- Right: profile photo -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_person_profile"
                        android:layout_width="120dp"
                        android:layout_height="170dp"
                        android:layout_marginStart="16dp"
                        app:cardBackgroundColor="@color/movieed_surface"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="6dp"
                        app:strokeColor="@color/movieed_border"
                        app:strokeWidth="1dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_person_profile"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/movieed_surface_elevated"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop"
                            tools:src="@tools:sample/backgrounds/scenic" />

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </FrameLayout>

            <!-- ============ STATS: plain row with hairline dividers, no cards ============ -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="20dp"
                android:background="@color/movieed_border" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_stat_movies"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/movieed_primary"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:text="48" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:letterSpacing="0.08"
                        android:text="MOVIES"
                        android:textColor="@color/movieed_text_secondary"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:background="@color/movieed_border" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_stat_series"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/movieed_primary"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:text="6" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:letterSpacing="0.08"
                        android:text="SERIES"
                        android:textColor="@color/movieed_text_secondary"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="28dp"
                    android:background="@color/movieed_border" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_stat_active_since"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/movieed_primary"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:text="1989" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:letterSpacing="0.08"
                        android:text="ACTIVE SINCE"
                        android:textColor="@color/movieed_text_secondary"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="20dp"
                android:background="@color/movieed_border" />

            <!-- Diary progress (only when diary data is provided) -->
            <LinearLayout
                android:id="@+id/card_person_watch_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tv_person_watched"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/movieed_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="12 of 46 credits logged" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_person_watched"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:indicatorColor="@color/movieed_primary"
                    app:trackColor="@color/movieed_surface_elevated"
                    app:trackCornerRadius="3dp"
                    app:trackThickness="6dp"
                    tools:progress="26" />

            </LinearLayout>

            <!-- ============ BIOGRAPHY ============ -->
            <TextView
                android:id="@+id/tv_biography_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="28dp"
                android:letterSpacing="0.12"
                android:text="BIOGRAPHY"
                android:textColor="@color/movieed_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_person_biography"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:lineSpacingExtra="5dp"
                android:maxLines="4"
                android:textColor="@color/movieed_text_primary"
                android:textSize="14sp"
                tools:text="Christian Charles Philip Bale is an English actor..." />

            <TextView
                android:id="@+id/tv_read_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="4dp"
                android:background="?attr/selectableItemBackground"
                android:paddingVertical="8dp"
                android:text="Read More"
                android:textColor="@color/movieed_accent"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- ============ KNOWN FOR ============
                 Same pattern as the Home screen lists (20dp start padding on the list itself,
                 no negative margins), so the first poster lines up with the headings. -->
            <TextView
                android:id="@+id/tv_known_for_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="24dp"
                android:letterSpacing="0.12"
                android:text="KNOWN FOR"
                android:textColor="@color/movieed_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_person_known_for"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="8dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_home_movie_card" />

            <!-- ============ FILMOGRAPHY ============ -->
            <LinearLayout
                android:id="@+id/section_filmography"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="28dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.12"
                        android:text="FILMOGRAPHY"
                        android:textColor="@color/movieed_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_filmography_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/movieed_text_secondary"
                        android:textSize="12sp"
                        tools:text="36 credits" />

                </LinearLayout>

                <!-- One compact row of equal-size chips. Dropdown chips open a menu;
                     the two toggle chips switch on/off. Chips that don't apply are hidden. -->
                <HorizontalScrollView
                    android:id="@+id/scroll_filters"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingHorizontal="20dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_role"
                            style="@style/Widget.Movieed.FilterChip.Dropdown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="All roles"
                            android:visibility="gone" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_type"
                            style="@style/Widget.Movieed.FilterChip.Dropdown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="All types" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_sort"
                            style="@style/Widget.Movieed.FilterChip.Dropdown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="Newest" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_decade"
                            style="@style/Widget.Movieed.FilterChip.Dropdown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="Any decade" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_hide_self"
                            style="@style/Widget.Movieed.FilterChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:checked="true"
                            android:text="Hide self roles" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_not_logged"
                            style="@style/Widget.Movieed.FilterChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="Not logged yet"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tv_filters_reset"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="10dp"
                            android:text="Reset"
                            android:textColor="@color/movieed_accent"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Plain list: hairline dividers are drawn by ListDividerDecoration -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_person_filmography"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingHorizontal="20dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_person_credit" />

                <TextView
                    android:id="@+id/tv_filmography_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:text="No credits match these filters."
                    android:textColor="@color/movieed_text_secondary"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_show_all_filmography"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="4dp"
                    android:text="Show more"
                    android:textColor="@color/movieed_accent"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>