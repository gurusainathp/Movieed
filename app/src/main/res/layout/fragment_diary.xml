<?xml version="1.0" encoding="utf-8"?><!-- No title: the tabs ARE the header. Large text tabs, a short indicator, nothing else. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/movieed_background">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tl_diary_tabs"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@android:color/transparent"
        app:tabGravity="fill"
        app:tabIndicator="@drawable/tab_indicator_minimal"
        app:tabIndicatorAnimationMode="elastic"
        app:tabIndicatorColor="@color/movieed_primary"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorGravity="bottom"
        app:tabIndicatorHeight="3dp"
        app:tabMinWidth="0dp"
        app:tabMode="fixed"
        app:tabPaddingBottom="10dp"
        app:tabPaddingEnd="8dp"
        app:tabPaddingStart="8dp"
        app:tabPaddingTop="4dp"
        app:tabRippleColor="@android:color/transparent"
        app:tabSelectedTextColor="@color/movieed_text_primary"
        app:tabTextAppearance="@style/TextAppearance.Movieed.Tab"
        app:tabTextColor="@color/movieed_text_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_diary_pager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tl_diary_tabs" />

</androidx.constraintlayout.widget.ConstraintLayout>
