<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/movieed_background">

    <!-- Full-bleed backdrop background like explore -->
    <ImageView
        android:id="@+id/iv_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:background="@color/movieed_surface_elevated"
        tools:src="@tools:sample/backgrounds/scenic" />

    <!-- Dark gradient overlay for readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B30F1015" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="70dp">

            <!-- Movie Info Header with Poster on the Right -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="top">

                <!-- Left Details -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_details_type_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_unselected_filter"
                        android:letterSpacing="0.1"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:textAllCaps="true"
                        android:textColor="@color/movieed_primary"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        tools:text="MOVIE" />

                    <TextView
                        android:id="@+id/tv_details_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/movieed_text_primary"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        tools:text="Oppenheimer" />

                    <TextView
                        android:id="@+id/tv_details_year"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/movieed_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="2023" />

                    <TextView
                        android:id="@+id/tv_details_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/movieed_accent"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="★ 8.9" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/cg_movie_genres"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/item_genre_badge" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_movie_providers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/item_provider" />

                </LinearLayout>

                <!-- Right Movie Poster Card (replaces the reason box position) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="110dp"
                    android:layout_height="160dp"
                    android:layout_marginStart="14dp"
                    app:cardBackgroundColor="@color/movieed_surface"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="6dp"
                    app:strokeColor="@color/movieed_border"
                    app:strokeWidth="1dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/iv_details_poster"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="@color/movieed_surface_elevated"
                        tools:src="@tools:sample/backgrounds/scenic" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Synopsis Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="SYNOPSIS"
                android:textColor="@color/movieed_primary"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_details_overview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:justificationMode="inter_word"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/movieed_text_primary"
                android:textSize="14sp"
                tools:text="The story of American scientist J. Robert Oppenheimer and his role in the development of the atomic bomb." />

            <!-- Cast Section -->
            <TextView
                android:id="@+id/tv_cast_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="TOP CAST"
                android:textColor="@color/movieed_primary"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_movie_cast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_cast" />

            <!-- Crew Section -->
            <TextView
                android:id="@+id/tv_crew_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="KEY CREW"
                android:textColor="@color/movieed_primary"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_movie_crew"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_cast" />

            <!-- Recommendations Section -->
            <TextView
                android:id="@+id/tv_recommendations_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="MORE LIKE THIS"
                android:textColor="@color/movieed_primary"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                android:textStyle="bold"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_movie_recommendations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:visibility="gone"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_home_movie_card" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Floating Quick Action Bar for Watchlist & Reaction -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_floating_action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="@color/movieed_surface"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/movieed_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_action_watchlist"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="+ Watchlist"
                android:textColor="@color/movieed_text_primary"
                app:strokeColor="@color/movieed_border" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_action_rate"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/movieed_primary"
                android:text="Rate"
                android:textColor="@color/movieed_background" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
