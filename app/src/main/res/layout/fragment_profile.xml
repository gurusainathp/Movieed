<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/movieed_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_profile_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/nav_profile"
            android:textColor="@color/movieed_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Your story, one film at a time."
            android:textColor="@color/movieed_text_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/movieed_surface"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/movieed_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_stat_total_films"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/movieed_primary"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        tools:text="14" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="FILMS"
                        android:textColor="@color/movieed_text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/movieed_surface"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/movieed_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_stat_watch_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/movieed_primary"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        tools:text="28 hrs" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="WATCH TIME"
                        android:textColor="@color/movieed_text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/movieed_surface"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/movieed_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_stat_avg_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/movieed_accent"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        tools:text="4.2" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="AVG RATING"
                        android:textColor="@color/movieed_text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/movieed_surface"
            app:cardCornerRadius="12dp"
            app:strokeColor="@color/movieed_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RATING DISTRIBUTION"
                    android:textColor="@color/movieed_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- 5 Stars Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="wrap_content"
                        android:text="5 ★"
                        android:textColor="@color/movieed_accent"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_rating_5"
                        android:layout_width="0dp"
                        android:layout_height="8dp"
                        android:layout_marginHorizontal="12dp"
                        android:layout_weight="1"
                        app:indicatorColor="@color/movieed_accent"
                        app:trackColor="@color/movieed_surface_elevated"
                        app:trackCornerRadius="4dp" />

                    <TextView
                        android:id="@+id/tv_count_rating_5"
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:textColor="@color/movieed_text_secondary"
                        android:textSize="12sp"
                        tools:text="6" />
                </LinearLayout>

                <!-- 4 Stars Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="wrap_content"
                        android:text="4 ★"
                        android:textColor="@color/movieed_accent"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_rating_4"
                        android:layout_width="0dp"
                        android:layout_height="8dp"
                        android:layout_marginHorizontal="12dp"
                        android:layout_weight="1"
                        app:indicatorColor="@color/movieed_accent"
                        app:trackColor="@color/movieed_surface_elevated"
                        app:trackCornerRadius="4dp" />

                    <TextView
                        android:id="@+id/tv_count_rating_4"
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:textColor="@color/movieed_text_secondary"
                        android:textSize="12sp"
                        tools:text="4" />
                </LinearLayout>

                <!-- 3 Stars Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="wrap_content"
                        android:text="3 ★"
                        android:textColor="@color/movieed_accent"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_rating_3"
                        android:layout_width="0dp"
                        android:layout_height="8dp"
                        android:layout_marginHorizontal="12dp"
                        android:layout_weight="1"
                        app:indicatorColor="@color/movieed_accent"
                        app:trackColor="@color/movieed_surface_elevated"
                        app:trackCornerRadius="4dp" />

                    <TextView
                        android:id="@+id/tv_count_rating_3"
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:textColor="@color/movieed_text_secondary"
                        android:textSize="12sp"
                        tools:text="2" />
                </LinearLayout>

                <!-- 2 Stars Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="wrap_content"
                        android:text="2 ★"
                        android:textColor="@color/movieed_accent"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_rating_2"
                        android:layout_width="0dp"
                        android:layout_height="8dp"
                        android:layout_marginHorizontal="12dp"
                        android:layout_weight="1"
                        app:indicatorColor="@color/movieed_accent"
                        app:trackColor="@color/movieed_surface_elevated"
                        app:trackCornerRadius="4dp" />

                    <TextView
                        android:id="@+id/tv_count_rating_2"
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:textColor="@color/movieed_text_secondary"
                        android:textSize="12sp"
                        tools:text="1" />
                </LinearLayout>

                <!-- 1 Star Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="wrap_content"
                        android:text="1 ★"
                        android:textColor="@color/movieed_accent"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_rating_1"
                        android:layout_width="0dp"
                        android:layout_height="8dp"
                        android:layout_marginHorizontal="12dp"
                        android:layout_weight="1"
                        app:indicatorColor="@color/movieed_accent"
                        app:trackColor="@color/movieed_surface_elevated"
                        app:trackCornerRadius="4dp" />

                    <TextView
                        android:id="@+id/tv_count_rating_1"
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:textColor="@color/movieed_text_secondary"
                        android:textSize="12sp"
                        tools:text="1" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- TMDB Official Attribution Footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="65dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/tmdb_attribution"
                android:src="@drawable/ic_tmdb_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tmdb_attribution"
                android:textColor="@color/movieed_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
