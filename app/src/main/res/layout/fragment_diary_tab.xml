<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/movieed_background">

    <TextView
        android:id="@+id/tv_tab_empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:gravity="center"
        android:text="No items found."
        android:textColor="@color/movieed_text_secondary"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_tab_grid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:listitem="@layout/item_diary_grid" />

    <!-- Wide Transparent Reaction Filter Bar (Watched Tab) -->
    <LinearLayout
        android:id="@+id/card_filter_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginBottom="16dp"
        android:baselineAligned="false"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/btn_filter_all"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_selected_filter"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="All"
            android:textColor="@color/movieed_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_filter_love"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_unselected_filter"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="😍"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/btn_filter_like"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_unselected_filter"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="🙂"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/btn_filter_umm"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_unselected_filter"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="😐"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/btn_filter_dislike"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_unselected_filter"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="🙁"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/btn_filter_hate"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_unselected_filter"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="😡"
            android:textSize="20sp" />

    </LinearLayout>

    <!-- Wide Swipeable Provider Filter Bar (Watchlist Tab) -->
    <HorizontalScrollView
        android:id="@+id/scroll_provider_filter_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginBottom="16dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/layout_provider_filters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_filter_prov_all"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/bg_selected_filter"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="All"
                android:textColor="@color/movieed_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>
    </HorizontalScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
