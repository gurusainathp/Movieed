<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="120dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="16dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_cast_poster"
        android:layout_width="120dp"
        android:layout_height="170dp"
        app:cardBackgroundColor="@color/movieed_surface"
        app:cardCornerRadius="10dp"
        app:strokeColor="@color/movieed_border"
        app:strokeWidth="1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_cast_profile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@color/movieed_surface_elevated"
            tools:src="@tools:sample/backgrounds/scenic" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tv_cast_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/movieed_text_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/card_cast_poster"
        app:layout_constraintStart_toStartOf="@id/card_cast_poster"
        app:layout_constraintTop_toBottomOf="@id/card_cast_poster"
        tools:text="Christian Bale" />

    <TextView
        android:id="@+id/tv_cast_character"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/movieed_text_secondary"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="@id/card_cast_poster"
        app:layout_constraintStart_toStartOf="@id/card_cast_poster"
        app:layout_constraintTop_toBottomOf="@id/tv_cast_name"
        tools:text="Bruce Wayne" />

</androidx.constraintlayout.widget.ConstraintLayout>
